# ==============================================================================
# Environment Configuration Template for CPC AdTech Lakehouse
# ==============================================================================
# Copy this file to .env and adjust variables as needed:
#   cp .env.example .env
# NEVER commit the actual .env file with sensitive credentials.

# --- Redpanda / Kafka ---
KAFKA_BOOTSTRAP_INTERNAL=redpanda:9092
KAFKA_BOOTSTRAP_EXTERNAL=localhost:19092

# --- MinIO / S3 Storage (Decoupled, S3-compatible) ---
S3_ENDPOINT=http://minio:9000
S3_ENDPOINT_EXTERNAL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=lakehouse
S3_REGION=us-east-1

# --- Host Data Root (WSL2 path to Drive D) ---
# Trong môi trường Ubuntu WSL2, phân vùng D: được gắn tại /mnt/d
DATA_ROOT=/mnt/d/docker_data/cpc_lakehouse

# --- Producer Simulation ---
SPEED_FACTOR=60
SIM_START_DATE=2026-01-01

# --- Alerting ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DISCORD_WEBHOOK_URL=
ALERT_DRY_RUN=true
